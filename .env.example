# Seen Command — credential names/defaults. Prefer the app's Settings tab; manual `.env` editing also works.
# Every value is OPTIONAL: a missing one just disables that one connector; the app still runs and
# the dashboard shows it as "not connected". Nothing here is ever committed.

# --- GitHub (Seen repo reads + gated writes; the tool repo is the exec team's task tracker) ---
GITHUB_TOKEN=            # a classic PAT with "repo" scope
SEEN_GITHUB_REPO=begindtheseen/seen
SEEN_DEFAULT_BRANCH=next-migration
SEEN_COMMAND_GITHUB_REPO=begindtheseen/seen-command
SEEN_COMMAND_DEFAULT_BRANCH=main

# --- Seen admin-stats (live business truth: users, MRR, jobs, errors, funnel) ---
SEEN_BASE_URL=https://seenjobs.io
SEEN_ADMIN_USERNAME=
SEEN_ADMIN_PASSWORD=

# --- Supabase (DB health + advisors + the ONLINE BRAIN mirror; migrations stay gated) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# optional, for security/perf advisors via the Management API:
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Stripe (optional direct MRR/subscription read; admin-stats already carries MRR) ---
STRIPE_SECRET_KEY=

# --- Vercel (optional deploy status) ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- AI reasoning lanes (tried in order: groq → gemini → cerebras → local Ollama → Anthropic) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CODER_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# Local, free, private: install Ollama + pull a model (see SETUP_M5.md).
OLLAMA_URL=http://localhost:11434
# Primary advanced coding runtime: open-source Cline CLI (install with `npm run agent:setup`, then
# authenticate once with `cline auth`). Cline owns repo exploration/checkpoints/compaction/terminal;
# Seen Command still owns protected paths, the full gate, review, git, and PR shipping.
CLINE_CLI_PATH=cline
CLINE_PROVIDER=cline     # default signed-in Cline provider; change only for a configured BYOK provider
CLINE_MODEL=openai/gpt-5.3-codex  # verified non-Qwen coding model; Qwen is disabled for this lane
CLINE_AGENT=1            # 0 disables Cline without disabling the older agentic fallbacks
CHAT_ENGINE=cline        # Board Room conversation uses authenticated Cline Pass; owned live-data skills run first
# The local GGUF fleet the competence router assigns work to (org/models.mjs). Comma-list the Ollama
# tags you've SERVED; each lights up its role automatically (e.g. qwen3:32b = CEO/orchestrator,
# qwen3-coder:30b = lead coder, deepseek-r1:32b = reviewer, glm-4.5-air = planner, mistral-small:119b =
# generalist, kimi-k2.7-code = long-horizon coder, qwen3:8b = fast router, llama3.1 = assistant backup,
# deepseek-coder-v2:lite = light coder). Empty → the router auto-detects via the Ollama /api/tags probe;
# with neither, it degrades to the hosted free lanes then frontier. Local-first, quality-first.
LOCAL_MODELS=
# Frontier (emergency backstop / hardest reasoning):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Shared brain (Chronos vault both Seen Command AND Claude read/write) ---
# Point this at the Seen repo's `memory/` dir to share one brain with Claude's MCP.
CHRONOS_VAULT=
# Optional explicit path to the seen repo (for the shared fact-writer); usually derived from the vault.
SEEN_REPO=
# Optional explicit path to the PRODUCT checkout the git→brain dev log narrates (brain/lib/git-episodes.mjs).
# Empty → SEEN_PRODUCT_REPO_DIR / the vault's parent / ../seen, exactly how the builder resolves it.
SEEN_REPO_PATH=

# --- Behavior ---
APPROVAL_TTL_HOURS=20    # how long a yes/no decision suppresses re-asking
PORT=4173

# --- Autonomous builder + overnight loop ---
# The builder needs a WRITABLE git checkout (not the read-only .app bundle). In dev these are auto-
# detected; for the packaged app point them at the checkouts on disk.
SEEN_COMMAND_REPO_DIR=   # this repo's checkout (default: the running dir)
SEEN_PRODUCT_REPO_DIR=   # the Seen product repo (default: ../seen)
# Overnight co-CEO loop (engine/overnight.mjs, run by the 6 AM launchd agent):
OVERNIGHT_BUILD_LABEL=auto-build   # tool-repo issues with this label are safe for the builder to ship
OVERNIGHT_MAX_BUILDS=5             # hard cap on autonomous builds per night
OVERNIGHT_AUTOMERGE=0              # 1 = auto-merge green tool-repo PRs; 0 = leave them for your morning click
AGENTIC_ENGINE=auto                 # cline = force Cline; auto = Cline first, then existing fallbacks

# --- Instagram Knowledge Compiler (local video-to-software worker) — NON-SECRET paths/username ONLY ---
# NEVER put an Instagram password here. The worker reuses a local Instaloader session you create once:
#   instaloader --login YOUR_IG_USERNAME
VSC_TOOL_DIR=             # vendored compiler dir (default: tools/video-software-compiler)
VSC_PYTHON=              # venv python (default: <SEEN_HOME>/data/vsc-venv/bin/python)
VSC_DATA_ROOT=           # per-creator project root (default: <SEEN_HOME>/data/instagram-projects)
VSC_DEFAULT_LIMIT=50     # newest N video posts per research job unless an explicit limit is given
CLAUDE_CLI_PATH=claude   # local Claude Code CLI used for bounded knowledge extraction
INSTAGRAM_SESSION_USER=  # username whose local Instaloader session the worker reuses (not a password)

# --- Aggregation Dashboard (Seen collectors run on this Mac; see docs/AGGREGATION.md) ---
# Same values as the Vercel Production secrets. Set them in Settings → Aggregation (never shown back).
SEEN_LOCAL_INGEST_TOKEN=            # = LOCAL_INDEED_INGEST_SECRET (Indeed Jobs)
SEEN_COMPANY_INTEL_INGEST_TOKEN=    # = LOCAL_COMPANY_INTEL_INGEST_SECRET (Company Intelligence)
# Optional https overrides (e.g. a preview deployment). Empty → https://seenjobs.io/...
SEEN_LOCAL_INGEST_URL=
SEEN_COMPANY_INTEL_INGEST_URL=
